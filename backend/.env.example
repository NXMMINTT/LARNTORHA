ENV=development                 # development|production
REPO_DRIVER=memory              # memory|dynamodb
DYNAMODB_TABLE=larntorha
# DYNAMODB_ENDPOINT_URL=http://localhost:8001   # DynamoDB Local (dev only)
AWS_REGION=ap-southeast-1
SESSION_SECRET=
CALLS_API_TOKEN=
INTERNAL_API_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# dev only: your LINE userId(s), auto-linked as the demo guardian of ยายสำลี (never set in production)
LINE_TO_USER_IDS=
# LINE Login channel ID that owns the LIFF app of the family dashboard (same provider as the OA)
LINE_LOGIN_CHANNEL_ID=
# Public HTTPS folder with the LINE card header images (backend/app/static/cards/*.png),
# e.g. https://raw.githubusercontent.com/<owner>/<repo>/main/backend/app/static/cards
CARD_IMAGE_BASE_URL=
APP_BASE_URL=http://localhost:3000
SEED_DEMO=true
DEMO_MODE=false                 # true ได้เฉพาะ dev/เวทีนำเสนอ

# Amazon Bedrock
AI_PROVIDER=fake                # bedrock|fake
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=               # model ID หรือ inference profile ID ของ Claude Haiku รุ่นล่าสุดที่ใช้ได้
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_TIMEOUT_SEC=20
RETAIN_TRANSCRIPT_DAYS=0
