ENV=development                 # development|production
REPO_DRIVER=memory              # memory|dynamodb
DYNAMODB_TABLE=larntorha
# DYNAMODB_ENDPOINT_URL=http://localhost:8001   # DynamoDB Local (dev only)
AWS_REGION=ap-southeast-1
SESSION_SECRET=
CALLS_API_TOKEN=
INTERNAL_API_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
APP_BASE_URL=http://localhost:3000
SEED_DEMO=true
DEMO_MODE=false                 # true ได้เฉพาะ dev/เวทีนำเสนอ

# Amazon Bedrock
AI_PROVIDER=fake                # bedrock|fake
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=               # model ID หรือ inference profile ID ของ Claude Haiku รุ่นล่าสุดที่ใช้ได้
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_TIMEOUT_SEC=20
RETAIN_TRANSCRIPT_DAYS=0
